  "sections": [
    {
      "h2": "Before you buy from anyone",
      "html": "<ul><li><strong>UK</strong>: check the firm on the <a href=\"https://register.fca.org.uk/\" rel=\"noopener\" target=\"_blank\">FCA Financial Services Register</a> and beware clone firms using real firms’ names.</li><li><strong>US</strong>: check the insurer and agent license with your state insurance department; the NAIC links to every state.</li><li><strong>EU</strong>: check with your national supervisor; EIOPA lists national authorities.</li></ul><p class=\"warn\"><strong>Ghost broking:</strong> cheap “insurance” sold through social media or messaging apps can be fake or based on false details, leaving you uninsured. Buy from authorised firms only.</p>"
    },
    {
      "h2": "Insurers vs brokers vs comparison sites",
      "html": "<p>An <strong>insurer</strong> carries the risk and pays claims. A <strong>broker</strong> or <strong>agent</strong> arranges cover with insurers; independent brokers can approach several. A <strong>comparison site</strong> shows quotes from participating providers and passes you to them to buy. Some brands are “managing general agents” that design products underwritten by other insurers; the policy documents name the actual insurer.</p>"
    }
  ],
  "faqs": [
    {
      "q": "Why aren’t there star ratings?",
      "a": "We don’t publish ratings or rankings we can’t back with our own verifiable testing. Use independent complaint data and the policy documents to compare."
    },
    {
      "q": "Is every insurer on comparison sites?",
      "a": "No. Some insurers sell only direct. Check those separately when you compare."
    }
  ],
